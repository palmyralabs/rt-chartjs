{
  "name": "@palmyralabs/rt-chartjs",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --p ./build.tsconfig.json && vite --config vite.config.js build",
    "compile": "tsc --p ./demo.tsconfig.json && tsc --p ./build.tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "dependencies": {
    "@palmyralabs/chartjs-utils": "github:palmyralabs/chartjs-converter",
    "@palmyralabs/palmyra-wire": "^1.2.1",
    "d3-scale-chromatic": "^3.1.0"
  },
  "devDependencies": {
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@palmyralabs/rt-forms-mui": "github:palmyralabs/rt-forms-mui",
    "@palmyralabs/ts-utils": "^0.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "glob": "^11.0.3",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "react-syntax-highlighter": "^15.6.6",
    "react-toastify": "^11.0.5",
    "serve-static": "^2.2.0",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "chart.js": "^4.5.0",
    "dayjs": "^1.11.18",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0"
  },
  "overrides": {
    "glob": "^11.0.3"
  }
